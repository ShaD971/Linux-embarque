#!/bin/sh
#
# Demarre le dashboard LVGL (rendu DRM/KMS).
#

DAEMON=/usr/bin/lvgl_dashboard
PIDFILE=/var/run/lvgl_dashboard.pid

start() {
	printf "Starting lvgl_dashboard: "
	start-stop-daemon -S -q -b -m -p "$PIDFILE" --exec "$DAEMON"
	[ $? = 0 ] && echo "OK" || echo "FAIL"
}
stop() {
	printf "Stopping lvgl_dashboard: "
	start-stop-daemon -K -q -p "$PIDFILE"
	[ $? = 0 ] && echo "OK" || echo "FAIL"
}
restart() {
	stop
	start
}

case "$1" in
  start)
	start
	;;
  stop)
	stop
	;;
  restart|reload)
	restart
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
